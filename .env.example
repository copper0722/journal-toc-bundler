# journal-toc-bundler — environment configuration
# Copy to .env and adjust for your setup. NOTHING here ships with real values.
# None of these are secrets except where you point them at your own credentials.

# ─────────────────────────── PostgreSQL ───────────────────────────
# PG registration/dedup features. All PG features degrade gracefully:
# if the DB is unreachable, the tool still builds the mega-md + bundles.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGDATABASE=journal_bundler
# Full libpq DSN for the psycopg2-based feature (--register-mesh).
# If unset, it is assembled from PGHOST/PGPORT/PGUSER/PGDATABASE above.
JOURNAL_PG_DSN=host=localhost port=5432 user=postgres dbname=journal_bundler
# psql client binary (used by the shell-out PG helpers).
PSQL_BIN=psql

# ─────────────────────────── Filesystem layout ───────────────────────────
# Canonical corpus root: promoted issue + per-article bundles land here.
JOURNAL_CORPUS_ROOT=~/journal-corpus/journal
# Podcast-transcript bundles root.
JOURNAL_PODCAST_ROOT=~/journal-corpus/podcast
# Runtime staging dir for a freshly-fetched issue before promotion.
JOURNAL_TOC_STAGING=~/Downloads/journal-toc/_staging
# Inbox dir where fetched binaries (article PDFs, audio, video) first land.
JOURNAL_INBOX=~/Downloads
# Topic store root for deterministically auto-routed article binaries.
JOURNAL_TOPIC_STORE_ROOT=~/journal-corpus/_topics
# Optional ssh host to receive the topic store remotely (blank = write locally).
JOURNAL_TOPIC_STORE_HOST=
# Comma-separated hostnames to treat as space-constrained (blank = none).
JOURNAL_SPACE_CONSTRAINED_HOSTS=

# ─────────────────────────── External tools ───────────────────────────
# MinerU: PDF -> markdown layout reconstruction (https://github.com/opendatalab/MinerU)
MINERU_BIN=mineru
# whisper.cpp CLI + model for optional media ASR (transcripts folded into raw.md).
WHISPER_CLI=whisper-cli
WHISPER_MODEL=~/.cache/whisper-cpp/ggml-small.bin
FFMPEG_BIN=ffmpeg

# ─────────────────────────── Crossref / Unpaywall ───────────────────────────
# Crossref polite-pool + Unpaywall require a contact email in the request URL.
# This is NOT a secret, but you must set it to YOUR OWN email.
# The default below is a non-functional placeholder.
CROSSREF_MAILTO=journal-bundler@example.com

# ─────────────────────────── Optional integrations ───────────────────────────
# Each is OFF unless you set it. Blank = feature disabled, no error.
#
# launchd job id to pause during MinerU runs (macOS only).
MINERU_DRAIN_JOB=
# Path to your own by-DOI open-access full-text fetcher (for --oa-fetch mode).
JOURNAL_FETCH_SCRIPT=
# Path to your own Telegram notify script (argv: message) for the watcher.
JOURNAL_TG_NOTIFY_SCRIPT=
# Path to an env file exporting SMTP creds, for the watcher --notify gmail mode.
JOURNAL_GMAIL_ENV=
# Directory holding your own mesh_client.py + register-mesh-tag.py (--register-mesh).
MESH_HELPER_DIR=
